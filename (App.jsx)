import	{	useState	}	from	"react";
import	"./App.css";
function	Counter({	label,	step	})	{
const	[count,	setCount]	=	useState(0);
return	(
<div	className="counter-card">
<h3>{label}</h3>
<h1>{count}</h1>
<div	className="btn-row">
<button	onClick={()	=>	setCount(count	-	step)}>-{step}</button>
<button	onClick={()	=>	setCount(0)}>Reset</button>
<button	onClick={()	=>	setCount(count	+	step)}>+{step}</button>
</div>
</div>
);
}
function	App()	{
return	(
<div	className="app">
<h1>useState	Example	—	Multiple	Counters</h1>
<div	className="counter-grid">
<Counter	label="Task	Counter"	step={1}	/>
<Counter	label="Like	Counter"	step={5}	/>
<Counter	label="Cart	Counter"	step={1}	/>
</div>
</div>
);
}
export	default	App;