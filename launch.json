// JavaScript object to JSON string
const student = { name: "Kavya", age: 22, skills: ["HTML", "CSS", "JS"] };
const jsonString = JSON.stringify(student);
console.log(jsonString);
// Output: {"name":"Kavya","age":22,"skills":["HTML","CSS","JS"]}
 
// JSON string back to JavaScript object
const jsonData = '{"name":"Arjun","age":24}';
const obj = JSON.parse(jsonData);
console.log(obj.name); // Arjun
console.log(obj.age);  // 24
// Using fetch() with Promises
fetch("https://jsonplaceholder.typicode.com/users/1")
  .then(response => response.json())
  .then(data => console.log(data.name))
  .catch(error => console.error("Error:", error));
 
// Using async/await (cleaner syntax)
async function getUser() {
  try {
    const response = await fetch("https://jsonplaceholder.typicode.com/users/1");
    if (!response.ok) throw new Error("Network response was not ok");
    const data = await response.json();
    console.log(data.name, data.email);
  } catch (error) {
    console.error("Error fetching user:", error);
  }
}
getUser()